# Secrets
.env
.env.*
!.env.example
backend/.env
# Vultr Managed Database CA cert (see docs/vultr-mysql-setup.md) -- not
# secret by itself, but keep certs/credentials out of git as a habit.
*.pem

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
.venv-local/
venv/

# Local dev databases. These are per-developer scratch state -- committing
# them means every teammate's study.db conflicts with every other one's.
# The schema is recreated on startup by Base.metadata.create_all().
*.db

# OS
.DS_Store

# Claude Code local settings (personal, machine-specific — not shared)
.claude/settings.local.json

# Personal notes (resume prep, session-to-session progress tracking) — not team-facing
RESUME_SUMMARY.md
todo.md
