# Generate this using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
GOOGLE_API_KEY=
# Choose a text model available to your key in Google AI Studio.
GEMINI_MODEL=
# Only needed if frontend runs on a different port:
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# Defaults to a local SQLite file (study.db) if unset -- fine for solo dev.
# To point at the team's Vultr Managed Database for MySQL instead, get the
# connection details from the Vultr dashboard (Managed Databases > your
# instance > Connection Details) and set:
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<database>?ssl_ca=/path/to/ca-certificate.crt
# Vultr enforces TLS -- download the CA cert from the same Connection
# Details page and point ssl_ca at it (skip the query string only for a
# throwaway local MySQL you control yourself, e.g. via Docker).
