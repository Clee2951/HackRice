# URL of the FastAPI backend. The renderer talks to it directly with the
# logged-in user's bearer token; the main process only uses this to pass
# along to the Presage capture child process.
# Do NOT put Vultr keys here -- those belong only in backend/.env.
BACKEND_URL=http://127.0.0.1:8000

# Where the casino_theme Next.js app is served from. The Electron window
# only displays whatever is here -- it does not serve the UI itself.
NEXT_APP_URL=http://localhost:3000

# Optional: require a PIN to exit the kiosk.
# Leave blank to let anyone close the app freely.
EXIT_PIN=

# Optional: which Node binary runs presage/session.mjs (the camera capture).
# Defaults to "node" on PATH. Set an absolute path if Electron is launched
# from somewhere that doesn't have node on its PATH.
# It must be a real Node binary, not Electron -- the SmartSpectra SDK's
# native addon is built against system Node's ABI.
PRESAGE_NODE=

# NOTE: the SmartSpectra/Presage API key is NOT read from this file.
# It lives in the repo-root .env (see .env.example there), which is also
# what presage/package.json's own scripts read.
