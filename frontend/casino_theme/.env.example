# Copy to .env.local and adjust if needed.

# URL of the FastAPI backend. Server-side only (no NEXT_PUBLIC_ prefix) --
# used by app/api/upload-url/route.ts, never sent to the browser.
BACKEND_URL=http://127.0.0.1:8000

# One shared demo account the upload-url route logs in as, since this app
# has no real login UI yet. Created automatically on first use if it
# doesn't already exist on the backend. See the comment in
# app/api/upload-url/route.ts for why this is a temporary stand-in for
# real per-user auth.
DEMO_ACCOUNT_EMAIL=demo@hackrice-study-app.com
DEMO_ACCOUNT_USERNAME=hackrice_demo
DEMO_ACCOUNT_PASSWORD=hackrice-demo-password
